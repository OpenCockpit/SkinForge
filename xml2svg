#!/bin/bash
# xml2svg <domain>
# xml2svg <compiled skin.xml | source .xmlinc> [dst .svg file] [--size WxH] [--include file ...] [-c commondir]
# A source file with no dst writes <file>.svg next to it; for a .xmlinc, fonts.xmlinc, colors.xmlinc, ... of the
# shared Common/src/skin (next to this tool's directory) and then of the same dir are included automatically if present.
# Without -c, includes are also looked up in Common/src/skin/<skin>, then Common/src/skin, like the build does.
extra=()
commondir="$(cd "$(dirname "$0")/../Common/src/skin" 2>/dev/null && pwd)"   # the shared building blocks
if [ -f "$1" ]; then
	src="$1"
	shift
	if [ -n "$1" ] && [[ "$1" != -* ]]; then
		dst="$1"
		shift
	else
		dst="${src%.*}.svg"
	fi
	if [[ "$src" == *.xmlinc ]]; then
		srcdir="$(cd "$(dirname "$src")" && pwd)"
		# the definitions (fonts, colors, radii, ...) every screen may use, the shared ones first so that those
		# of the directory win, not the file itself
		incdirs=()
		[ -n "$commondir" ] && [ "$commondir" != "$srcdir" ] && incdirs+=("$commondir")
		incdirs+=("$srcdir")
		for incdir in "${incdirs[@]}"; do
			for inc in fonts.xmlinc colors.xmlinc radii.xmlinc frames.xmlinc screenpart_globals.xmlinc globals.xmlinc display_globals.xmlinc; do
				[ "$inc" != "$(basename "$src")" ] && [ -f "$incdir/$inc" ] && extra+=(--include "$incdir/$inc")
			done
		done
	fi
	if [[ "$src" == *.xmlinc || "$src" == *.xml ]] && [ -n "$commondir" ]; then
		extra+=(-c "$commondir/$(basename "$(cd "$(dirname "$src")" && pwd)")")   # a later -c of the caller wins
	fi
elif [ -z "$2" ]; then
	domain=$(getdomain $1)
	if [ -z "$domain" ]; then
		echo "$0: '$1' is neither a file nor a known domain"
		exit 1
	fi
	src="$HOME/git/rel/$domain/src/skin/default/skin.xml"
	dst="$HOME/git/rel/$domain/src/skin/default/skin.svg"
	shift
else
	src="$1"
	dst="$2"
	shift 2
fi

# %PLUGIN% in a source is the name of the plugin's directory (the build replaces it); not known for the shared Common
plugin=$("$(dirname "$0")"/getdomain "$(cd "$(dirname "$src")" && pwd)")
if [ -n "$plugin" ] && [ "$plugin" != "Common" ]; then
	extra+=(--plugin "$plugin")
fi

if [ -z "$src" ] || [ -z "$dst" ]; then
	echo "$0 <compiled skin.xml | source .xmlinc> [dst .svg file] [--size WxH] [--include fonts.xmlinc ...] [-c commondir]"
	exit 1
fi

if [ -f "$src" ]; then
	python "$(dirname "$0")"/src/xml2svg.py -i "$src" -o "$dst" "${extra[@]}" "$@"
else
	echo no $src available
fi
