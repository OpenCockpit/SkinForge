#!/bin/bash
# xml2svg <domain>
# xml2svg <compiled skin.xml | source .xmlinc> [dst .svg file] [--size WxH] [--include file ...] [-c commondir]
# A source file with no dst writes <file>.svg next to it; for a .xmlinc, fonts.xmlinc
# and colors.xmlinc from the same dir are included automatically if present.
extra=()
if [ -f "$1" ]; then
	src="$1"
	shift
	if [ -n "$1" ] && [[ "$1" != -* ]]; then
		dst="$1"
		shift
	else
		dst="${src%.*}.svg"
	fi
	if [[ "$src" == *.xmlinc ]]; then
		srcdir="$(dirname "$src")"
		# the definitions (fonts, colors, radii, ...) every screen of the directory may use, not the file itself
		for inc in fonts.xmlinc colors.xmlinc radii.xmlinc screenpart_fonts.xmlinc screenpart_colors.xmlinc screenpart_globals.xmlinc; do
			[ "$inc" != "$(basename "$src")" ] && [ -f "$srcdir/$inc" ] && extra+=(--include "$srcdir/$inc")
		done
		extra+=(-c "$srcdir")
	fi
elif [ -z "$2" ]; then
	domain=$(getdomain $1)
	if [ -z "$domain" ]; then
		echo "$0: '$1' is neither a file nor a known domain"
		exit 1
	fi
	src="$HOME/git/rel/$domain/src/skin/default/skin.xml"
	dst="$HOME/git/rel/$domain/src/skin/default/skin.svg"
	shift
else
	src="$1"
	dst="$2"
	shift 2
fi

# %PLUGIN% in a source is the name of the plugin's directory (the build replaces it); not known for the shared Common
plugin=$("$(dirname "$0")"/getdomain "$(cd "$(dirname "$src")" && pwd)")
if [ -n "$plugin" ] && [ "$plugin" != "Common" ]; then
	extra+=(--plugin "$plugin")
fi

if [ -z "$src" ] || [ -z "$dst" ]; then
	echo "$0 <compiled skin.xml | source .xmlinc> [dst .svg file] [--size WxH] [--include fonts.xmlinc ...] [-c commondir]"
	exit 1
fi

if [ -f "$src" ]; then
	python "$(dirname "$0")"/src/xml2svg.py -i "$src" -o "$dst" "${extra[@]}" "$@"
else
	echo no $src available
fi
