#!/bin/bash
. "$(dirname "$0")/common"

domain=$("$(dirname "$0")/getdomain" "$1")
echo "Domain: $domain"
if [ -z "$domain" ]; then
	echo "Error: not inside a recognized git/dev or git/rel domain directory"
	exit 1
fi

skin="${2:-default}"
base="${3:-$GIT_DEV}"
git="$base/$domain"
echo git: $git

# Only the full documents (skin.yml -> skin.xml). The .ymlinc includes are not converted into the
# source tree any more: xmlinc.py generates the .xmlinc it needs on demand, into a temp dir.
for file in $git/src/skin/*.yml $git/src/skin/$skin/*.yml; do
	if [ -f "$file" ]; then
		echo "Processing $file..."
		python "$(dirname "$0")"/src/yml2xml.py -i "$file"
	fi
done
