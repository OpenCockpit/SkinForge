#!/bin/bash
. "$(dirname "$0")/common"

domain=$("$(dirname "$0")/getdomain" "$1")
if [ -z "$domain" ]; then
	echo no valid domain specified
	exit 1
fi
echo "Domain: $domain"

srcbase="${2:-$GIT_DEV}"
dstbase="${3:-$GIT_REL}"
cmnbase="${4:-$GIT_DEV}"
srcroot=$srcbase/$domain
dstroot=$dstbase/$domain
srcskin=$srcroot/src/skin
dstskin=$dstroot/src/skin
cmnroot=$cmnbase/Common

scriptdir=$(dirname "$0")

if [ ! -d "$dstskin" ]; then
	echo "Error: $dstskin does not exist"
	exit 1
fi

for file in "$dstskin/"*; do
	[ -d "$file" ] || continue
	skin=$(basename "$file")

	# a skin is the plugin's own source: skin.xml, or the skin.yml/skin.zml it is generated from (a source tree of
	# a yml/zml based plugin need not keep the generated skin.xml)
	if [ ! -f "$srcskin/$skin/skin.xml" ] && [ ! -f "$srcskin/$skin/skin.yml" ] && [ ! -f "$srcskin/$skin/skin.zml" ]; then
		echo "skin: $skin: no skin.xml, skin.yml or skin.zml in $srcskin/$skin, skipping"
		continue
	else
		echo "skin: $skin"

		# expand zml to yml if a *.zml/*.zmlinc changed in cmn for this variant
		if [ -n "$(git -C "$cmnroot" status --porcelain -- "src/skin/*.zml" "src/skin/*.zmlinc" "src/skin/$skin/*.zml" "src/skin/$skin/*.zmlinc" 2>/dev/null)" ]; then
			echo "cmn zml changed, expanding..."
			(cd "$cmnroot" && "$scriptdir/zml2ymldomain" . "$skin" "$cmnbase")
		else
			echo "cmn zml unchanged, skipping expansion"
		fi

		# expand zml to yml if a *.zml/*.zmlinc changed in src for this variant
		if [ -n "$(git -C "$srcroot" status --porcelain -- "src/skin/*.zml" "src/skin/*.zmlinc" "src/skin/$skin/*.zml" "src/skin/$skin/*.zmlinc" 2>/dev/null)" ]; then
			echo "src zml changed, expanding..."
			(cd "$srcroot" && "$scriptdir/zml2ymldomain" . "$skin" "$srcbase")
		else
			echo "src zml unchanged, skipping expansion"
		fi
	fi
done

# hand off to ymlcompile for the yml->xml+ conversion, xmlinc compile, and
# xmlpretty reformat - zmlcompile's own job ends once .zml/.zmlinc sources
# have been expanded down to plain .yml/.ymlinc
"$scriptdir/ymlcompile" "$1" "$srcbase" "$dstbase" "$cmnbase"
