#!/bin/bash
# yml2svg <source .yml/.ymlinc> [dst .svg file] [--size WxH] [--include file ...] [-c commondir] [--srcdir dir]
# Draws the layout of a YAML skin source: the source is converted to a temporary .xmlinc (yml2xml) and
# handed to xml2svg, the temporary file is removed again. With no dst the .svg is written next to the source.
# Includes (<xmlinc>) are looked up in the directory of the source, or in --srcdir if given; a .ymlinc
# include is converted on demand like in a real build. fonts, colors, radii, frames,
# screenpart_globals, globals (the plugin's own, after the shared ones: it wins) and display_globals (fonts and colors of a front panel skin) of the shared
# Common/src/skin (next to this tool's directory) and then of that directory (.xmlinc, or else .ymlinc) are included automatically if present.
# Without -c, includes are also looked up in Common/src/skin/<skin>, then Common/src/skin, like the build does.
scriptdir="$(dirname "$0")"
src="$1"
if [ -z "$src" ] || [ ! -f "$src" ]; then
	echo "$0 <source .yml/.ymlinc> [dst .svg file] [--size WxH] [--include file ...] [-c commondir] [--srcdir dir]"
	exit 1
fi
shift
if [ -n "$1" ] && [[ "$1" != -* ]]; then
	dst="$1"
	shift
else
	dst="${src%.*}.svg"
fi

srcdir="$(dirname "$src")"
args=()
commondir="$(cd "$scriptdir/../Common/src/skin" 2>/dev/null && pwd)"   # the shared building blocks
while [ $# -gt 0 ]; do
	case "$1" in
	--srcdir)
		srcdir="$2"
		shift 2
		;;
	*)
		args+=("$1")
		shift
		;;
	esac
done

tmp="$(mktemp -d)" || exit 1
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/work" "$tmp/inc"

xml="$tmp/work/$(basename "${src%.*}").xmlinc"
python "$scriptdir"/src/yml2xml.py --marks -i "$src" -o "$xml" || exit 1

extra=()
# the shared definitions first, the plugin's own after them: it wins
incdirs=()
[ -n "$commondir" ] && [ "$commondir" != "$(cd "$srcdir" && pwd)" ] && incdirs+=("$commondir")
incdirs+=("$srcdir")
for incdir in "${incdirs[@]}"; do
	for inc in fonts colors radii frames screenpart_globals globals display_globals; do
		[ "$inc" = "$(basename "${src%.*}")" ] && continue   # not the file itself
		if [ -f "$incdir/$inc.xmlinc" ]; then
			extra+=(--include "$incdir/$inc.xmlinc")
		elif [ -f "$incdir/$inc.ymlinc" ]; then
			# a caller that draws many files of one directory (gitupdateskin) sets YML2SVG_CACHE: converted once there
			cache="$tmp/inc/$(echo "$incdir" | tr '/:' '__')"
			if [ -n "$YML2SVG_CACHE" ]; then
				cache="$YML2SVG_CACHE/$(echo "$incdir" | tr '/:' '__')"
			fi
			mkdir -p "$cache"
			if [ ! -f "$cache/$inc.xmlinc" ] || [ "$incdir/$inc.ymlinc" -nt "$cache/$inc.xmlinc" ]; then
				python "$scriptdir"/src/yml2xml.py --marks -i "$incdir/$inc.ymlinc" -o "$cache/$inc.xmlinc" || exit 1
			fi
			extra+=(--include "$cache/$inc.xmlinc")
		fi
	done
done

# %PLUGIN% in a source is the name of the plugin's directory (the build replaces it); not known for the shared Common
plugin=$("$scriptdir"/getdomain "$(cd "$srcdir" && pwd)")
if [ -n "$plugin" ] && [ "$plugin" != "Common" ]; then
	extra+=(--plugin "$plugin")
fi

# the build passes Common/src/skin/<skin> (the includes are looked up there and in its parent) as the common dir
cmndir="$srcdir"
[ -n "$commondir" ] && cmndir="$commondir/$(basename "$(cd "$srcdir" && pwd)")"
python "$scriptdir"/src/xml2svg.py -i "$xml" -o "$dst" --srcdir "$srcdir" -c "$cmndir" "${extra[@]}" "${args[@]}"
